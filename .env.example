# ==========================================================================
# Wise API Manager — exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o arquivo .env real.
# ==========================================================================

# --- Ambiente -------------------------------------------------------------
NODE_ENV=development

# --- Banco de dados (PostgreSQL) -----------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wise?schema=public"

# --- Fila / cache (Redis) -------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Autenticação --------------------------------------------------------
# Segredo de assinatura da sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- API (apps/api) -------------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"

# --- Painel web (apps/web) -----------------------------------------------
# URL da API consumida server-side pelo Next (BFF). Nunca exposta ao browser.
API_URL="http://localhost:3001"

# --- Criptografia do CredentialVault -------------------------------------
# Chave de 32 bytes em base64. Gere com: openssl rand -base64 32
# Usada para AES-256-GCM. Rotacionável via ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_PREVIOUS=""

# --- Meta / Graph API -----------------------------------------------------
# Centralizamos versão e base para nunca espalhar graph.facebook.com/vXX.X.
# VERIFIQUE a versão GA atual no changelog oficial antes de subir para produção:
# https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_BASE_URL="https://graph.facebook.com"
META_GRAPH_VERSION="v23.0"

# --- Meta App (Meta for Developers) --------------------------------------
META_APP_ID=""
# NUNCA exponha o App Secret ao frontend. Apenas backend/worker.
META_APP_SECRET=""
# Config ID do Facebook Login for Business usado no Embedded Signup.
META_CONFIG_ID=""
# redirect_uri usado na troca de code por token (Embedded Signup).
META_REDIRECT_URI="http://localhost:3000/meta/callback"

# --- Webhooks Meta --------------------------------------------------------
# Token de verificação usado no handshake GET do webhook.
META_WEBHOOK_VERIFY_TOKEN=""

# --- Feature flags (evolução de contas 2026) -----------------------------
# Mantidas em false até que a API oficial esteja GA para as contas.
# A detecção de capacidades (capability detection) tem precedência sobre estas.
META_NEW_ACCOUNT_MODEL=false
META_NEW_MESSAGING_ACCOUNT=false

# --- Workers: rate control e sincronização --------------------------------
# Válvula de segurança de envio por número (spec §41) — NÃO são limites da Meta.
SEND_RATE_CAPACITY=60
SEND_RATE_PER_SEC=10
# Intervalo do sync periódico de contas (ms) — spec §50.
SYNC_INTERVAL_MS=1800000

# --- Observabilidade ------------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN="" # backend/worker/frontend (opcional)
# Protege o endpoint /metrics (Prometheus). Se vazio, /metrics fica aberto —
# restrinja o acesso na rede. Se definido, exige Authorization: Bearer <token>.
# METRICS_TOKEN=""
