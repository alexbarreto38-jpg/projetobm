# Versão da Graph API da Meta usada em todas as chamadas.
META_API_VERSION=v21.0

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Webhook (comando `webhook`)
# Token do handshake de verificação (você escolhe; o mesmo vai no painel da Meta)
WEBHOOK_VERIFY_TOKEN=troque-este-token
# App Secret do app da Meta, usado para validar a assinatura X-Hub-Signature-256
META_APP_SECRET=
