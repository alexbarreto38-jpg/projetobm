    "@wise/queue": "workspace:*",
    "@wise/types": "workspace:*",
    "@wise/validation": "workspace:*",
    "fastify": "^4.28.1",
    "zod": "^3.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
